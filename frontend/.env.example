# FoundBack web app — environment variables (Vercel → Project → Settings → Environment Variables)

# Leave empty (recommended): the app calls /api on its own domain and vercel.json
# rewrites it to Railway, so the refresh cookie is first-party.
# Set only if you want the browser to call the API directly (then set
# COOKIE_SAMESITE=none on the API and add the domain to the CSP connect-src).
VITE_API_URL=
