# ---------------------------------------------------------------
# FoundBack API — environment variables (copy to .env for local dev)
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Railway: use the DATABASE_URL reference variable from the Postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foundback
# Set to true when your Postgres requires TLS from outside the private network
DATABASE_SSL=false

# Browser origins allowed by CORS (comma-separated; * wildcard allowed for previews)
CORS_ORIGINS=http://localhost:5173,https://foundback.vercel.app,https://*.vercel.app
APP_URL=http://localhost:5173
# Every integration key below can also be set or changed later in Admin → Settings
# (stored encrypted in the database); the admin value wins over this file.

# Number of proxies in front of the API (Railway = 1; add 1 if Vercel rewrites /api)
TRUST_PROXY=1

# --- Secrets: generate each with `openssl rand -base64 48` (ENCRYPTION_KEY: `openssl rand -base64 32`)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32_output_xxxxxxxx=
HASH_PEPPER=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax when the web app proxies /api through Vercel (recommended); none when calling Railway directly
COOKIE_SAMESITE=lax

# --- Google sign-in (OAuth client ID of type "Web application")

# --- User sign-in: Firebase Authentication (Google + email/password).
# Firebase console → Project settings → General → Your apps → Web app.
# Can also be set in Admin → Settings → Sign-in.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Staff 2-step codes: without a Resend key they're printed in the API log, and
# OTP_DEV_ECHO=true also shows them on screen (local only, ignored in production).
OTP_DEV_ECHO=true

# --- Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=FoundBack <no-reply@yourdomain.com>

# --- Geocoding (Nominatim). Use your contact email per the OSM usage policy.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=you@example.com

# --- Cloudflare R2 (private bucket for photos). Leave empty locally: files are then
# stored in Postgres (fine for development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=foundback-images
# Lifetime of signed image URLs in seconds (spec: 5 minutes)
SIGNED_URL_TTL_SECONDS=300
# Public base URL of the API, only used for locally stored files. Leave empty when
# the web app reaches the API through the /api rewrite.
API_PUBLIC_URL=

# --- AI: translation of posts/chat (none | ai | google | deepl) and photo moderation (none | openai).
# "ai" tries the providers in AI_PROVIDER_ORDER until one answers.
TRANSLATE_PROVIDER=ai
MODERATION_PROVIDER=openai
AI_PROVIDER_ORDER=openai,gemini,openrouter
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# --- Live location / VPN check: block | flag | off. IPINFO_TOKEN (free at ipinfo.io)
# lets the VPN check work everywhere; without it, CDN country headers are used.
REQUIRE_LIVE_LOCATION=true
VPN_POLICY=block
IPINFO_TOKEN=

# --- First admin (created on start if missing). Change the password in Admin → Settings.
# Quote values that contain # in this file, e.g. ADMIN_INITIAL_PASSWORD="abc#123".
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Web push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Safe handover places (OpenStreetMap Overpass API)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Background jobs (claim expiry, 90-day reminders, handover reminders). Set false on extra replicas.
JOBS_ENABLED=true
